{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oresoftware:grpc-pg-control:v1",
  "$ref": "#/$defs/CheckTargetSummary",
  "$defs": {
    "DatabaseTarget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "DatabaseTarget",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["databaseAlias", "schemas"],
      "properties": {
        "databaseAlias": { "type": "string", "minLength": 1 },
        "schemas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DriftKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "DriftKind",
      "type": "string",
      "enum": [
        "DRIFT_KIND_UNSPECIFIED",
        "DRIFT_KIND_MISSING_FROM_WITNESS",
        "DRIFT_KIND_MISSING_FROM_DATABASE",
        "DRIFT_KIND_COLUMN_MISMATCH",
        "DRIFT_KIND_CONFIGURATION",
        "DRIFT_KIND_CONTRACT_MISMATCH"
      ]
    },
    "Drift": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Drift",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["kind", "witness", "databaseAlias", "schema", "table", "column", "expected", "actual"],
      "properties": {
        "kind": { "$ref": "urn:oresoftware:grpc-pg-control:v1#/$defs/DriftKind" },
        "witness": { "type": "string" },
        "databaseAlias": { "type": "string" },
        "schema": { "type": "string" },
        "table": { "type": "string" },
        "column": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" }
      }
    },
    "WitnessSummary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "WitnessSummary",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["source", "revision", "fingerprint", "relationCount", "columnCount", "lineage", "artifactDigest", "contractVersion"],
      "properties": {
        "source": { "type": "string" },
        "revision": { "type": "string" },
        "fingerprint": { "type": "string" },
        "relationCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "columnCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "lineage": { "type": "string" },
        "artifactDigest": { "type": "string" },
        "contractVersion": { "type": "string" }
      }
    },
    "CheckTargetSummary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CheckTargetSummary",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["target", "balanced", "witnessCount", "driftCount"],
      "properties": {
        "target": { "$ref": "urn:oresoftware:grpc-pg-control:v1#/$defs/DatabaseTarget" },
        "balanced": { "type": "boolean" },
        "witnessCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "driftCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    }
  }
}
