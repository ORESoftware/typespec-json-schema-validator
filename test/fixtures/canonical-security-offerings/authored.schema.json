{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canonical-cloud:security-offerings:v1",
  "$defs": {
    "SecurityOfferCode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SecurityOfferCode",
      "type": "string",
      "enum": ["security_review", "penetration_test", "continuous_security"]
    },
    "BillingUnit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "BillingUnit",
      "type": "string",
      "enum": ["fixed", "monthly"]
    },
    "CustomerSegment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CustomerSegment",
      "type": "string",
      "enum": ["business_to_business"]
    },
    "PricingCurrency": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PricingCurrency",
      "type": "string",
      "enum": ["USD"]
    },
    "CommercialAuthority": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CommercialAuthority",
      "type": "string",
      "enum": ["signed_sow"]
    },
    "SecurityIndustryProfile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SecurityIndustryProfile",
      "type": "string",
      "enum": [
        "financial_services",
        "healthcare",
        "cloud_saas_ai",
        "ecommerce_payments",
        "public_sector"
      ]
    },
    "SecurityOffering": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SecurityOffering",
      "type": "object",
      "properties": {
        "rank": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "code": { "$ref": "SecurityOfferCode" },
        "name": { "type": "string" },
        "priceMinUsd": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "priceMaxUsd": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "billingUnit": { "$ref": "BillingUnit" },
        "minimumTermMonths": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "deliveryWindow": { "type": "string" },
        "coreOffer": { "type": "string" },
        "activeTesting": { "type": "boolean" },
        "independentAssurance": { "type": "boolean" },
        "includedCapabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredPreconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "industryProfiles": {
          "type": "array",
          "items": { "$ref": "SecurityIndustryProfile" }
        }
      },
      "required": [
        "rank",
        "code",
        "name",
        "priceMinUsd",
        "priceMaxUsd",
        "billingUnit",
        "deliveryWindow",
        "coreOffer",
        "activeTesting",
        "independentAssurance",
        "includedCapabilities",
        "exclusions",
        "requiredPreconditions",
        "industryProfiles"
      ],
      "unevaluatedProperties": false
    },
    "SecurityOfferingCatalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SecurityOfferingCatalog",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "customerSegment": { "$ref": "CustomerSegment" },
        "currency": { "$ref": "PricingCurrency" },
        "commercialAuthority": { "$ref": "CommercialAuthority" },
        "pricingStatus": { "type": "string" },
        "effectiveDate": { "type": "string" },
        "sourceDocument": { "type": "string" },
        "offers": {
          "type": "array",
          "items": { "$ref": "SecurityOffering" }
        }
      },
      "required": [
        "schemaVersion",
        "customerSegment",
        "currency",
        "commercialAuthority",
        "pricingStatus",
        "effectiveDate",
        "sourceDocument",
        "offers"
      ],
      "unevaluatedProperties": false
    }
  }
}
