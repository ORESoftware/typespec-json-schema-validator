{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/runtime-evidence/v1",
  "title": "TypeSpec JSON Schema validator runtime evidence",
  "description": "Non-authoritative, exact-input evidence emitted by language/runtime validator adapters and bound to one verified parity-approved Contract IR. Raw stdout, stderr, payloads, and credentials are intentionally outside this format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contractIr", "inputDigest", "corpusDigest", "adapters"],
  "properties": {
    "schema": {
      "const": "ores.typespec-json-schema-validator.runtime-evidence/v1"
    },
    "contractIr": {
      "$ref": "#/$defs/contractIrBinding"
    },
    "inputDigest": {
      "$ref": "#/$defs/sha256"
    },
    "corpusDigest": {
      "$ref": "#/$defs/sha256"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "contractIrBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "irId", "parityReceipt"],
      "properties": {
        "schema": {
          "const": "ores.typespec-json-schema-validator.contract-ir/v1"
        },
        "irId": {
          "$ref": "#/$defs/sha256"
        },
        "parityReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "digest"],
          "properties": {
            "runId": {
              "$ref": "#/$defs/sha256"
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "runtime",
        "validator",
        "toolchain",
        "status",
        "results"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "language": {
          "allOf": [
            { "$ref": "#/$defs/boundedText" },
            { "maxLength": 128 }
          ]
        },
        "runtime": {
          "allOf": [
            { "$ref": "#/$defs/boundedText" },
            { "maxLength": 128 }
          ]
        },
        "validator": {
          "allOf": [
            { "$ref": "#/$defs/boundedText" },
            { "maxLength": 128 }
          ]
        },
        "toolchain": {
          "$ref": "#/$defs/boundedText"
        },
        "status": {
          "enum": ["passed", "failed", "skipped", "unsupported"]
        },
        "results": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "declaration", "verdict"],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/identifier"
        },
        "declaration": {
          "$ref": "#/$defs/boundedText"
        },
        "verdict": {
          "enum": ["accepted", "rejected", "error", "skipped", "unsupported"]
        }
      }
    }
  }
}
