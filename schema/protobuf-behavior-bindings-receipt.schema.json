{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/protobuf-behavior-bindings-receipt.v1.schema.json",
  "title": "ORESoftware Protobuf behavior bindings receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "admissible",
    "projectionDigest",
    "bindingsDigest",
    "behaviorContractDigest",
    "requireAllMethods",
    "findings",
    "verificationId"
  ],
  "properties": {
    "schema": { "const": "ores.typespec-json-schema-validator.protobuf-behavior-bindings-receipt/v1" },
    "status": { "enum": ["passed", "stopped_for_evaluation"] },
    "admissible": { "type": "boolean" },
    "projectionDigest": { "$ref": "#/$defs/sha256" },
    "bindingsDigest": { "$ref": "#/$defs/sha256" },
    "behaviorContractDigest": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "requireAllMethods": { "type": "boolean" },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/finding" }
    },
    "verificationId": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "admissible": { "const": true },
          "findings": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": { "admissible": { "const": false } }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "subject", "message", "expected", "actual", "fingerprint"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {},
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
