{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.github.io/typespec-json-schema-validator/schema/projection-verification-policy.schema.json",
  "title": "TypeSpec JSON Schema projection verification policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inputs",
    "toolchains",
    "requiredProjections",
    "outputs",
    "approvedDeltas",
    "runtimeValidators"
  ],
  "properties": {
    "schema": {
      "const": "ores.typespec-json-schema-validator.projection-verification-policy/v1"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationInventory",
        "projectionMetadata",
        "emitterConfiguration"
      ],
      "properties": {
        "operationInventory": { "$ref": "#/$defs/fileInput" },
        "projectionMetadata": { "$ref": "#/$defs/fileInput" },
        "emitterConfiguration": { "$ref": "#/$defs/fileInput" }
      }
    },
    "toolchains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/toolchain" }
    },
    "requiredProjections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/output" }
    },
    "approvedDeltas": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "object" }
    },
    "runtimeValidators": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,126}[A-Za-z0-9])?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//)(?!.*\\\\).+[^/]$"
    },
    "fileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifactDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "artifactDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "projection"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[^\\s/]+/[^\\s]+$"
        },
        "projection": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
