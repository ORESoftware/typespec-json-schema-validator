{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/language-boundaries/v1/manifest.schema.json",
  "title": "TJSV language boundary manifest",
  "type": "object",
  "required": ["schema", "minimumDistinctLanguages", "authorities", "targets"],
  "properties": {
    "schema": {
      "const": "ores.typespec-json-schema-validator.language-boundaries/v1"
    },
    "minimumDistinctLanguages": {
      "type": "integer",
      "minimum": 2,
      "maximum": 64
    },
    "authorities": {
      "type": "object",
      "required": ["typeSpec", "jsonSchema", "generatedWitness"],
      "properties": {
        "typeSpec": { "const": "peer" },
        "jsonSchema": { "const": "peer" },
        "generatedWitness": { "const": "evidence_only" }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+._:@/-]{0,127}$"
    },
    "target": {
      "type": "object",
      "required": ["language", "runtime", "required", "ingress", "egress", "evidence"],
      "properties": {
        "language": { "$ref": "#/$defs/identity" },
        "runtime": { "$ref": "#/$defs/identity" },
        "required": { "type": "boolean" },
        "ingress": { "type": "boolean" },
        "egress": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*//).+\\.json$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
