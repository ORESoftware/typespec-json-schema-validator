{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/runtime-evidence/v2",
  "title": "TypeSpec JSON Schema validator semantic runtime evidence",
  "description": "Non-authoritative runtime evidence with canonical accepted-output digests and privacy-bounded stable validation errors. Raw payloads, raw rejected values, stdout, stderr, environment values, stack traces, credentials, and library-specific error strings are intentionally outside this format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contractIrId", "inputDigest", "corpusDigest", "adapters"],
  "properties": {
    "schema": { "const": "ores.typespec-json-schema-validator.runtime-evidence/v2" },
    "contractIrId": { "$ref": "#/$defs/sha256" },
    "inputDigest": { "$ref": "#/$defs/sha256" },
    "corpusDigest": { "$ref": "#/$defs/sha256" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "jsonPointer": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:/(?:[^~/\\u0000-\\u001f\\u007f]|~0|~1)*)*$"
    },
    "errorParam": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "$ref": "#/$defs/identifier" }
      ]
    },
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "params"],
      "properties": {
        "path": { "$ref": "#/$defs/jsonPointer" },
        "code": { "$ref": "#/$defs/identifier" },
        "params": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/errorParam" }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "runtime", "validator", "toolchain", "status", "results"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "language": { "allOf": [{ "$ref": "#/$defs/boundedText" }, { "maxLength": 128 }] },
        "runtime": { "allOf": [{ "$ref": "#/$defs/boundedText" }, { "maxLength": 128 }] },
        "validator": { "allOf": [{ "$ref": "#/$defs/boundedText" }, { "maxLength": 128 }] },
        "toolchain": { "$ref": "#/$defs/boundedText" },
        "status": { "enum": ["passed", "failed", "skipped", "unsupported"] },
        "results": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "declaration", "verdict", "inputDigest", "outputDigest", "errors"],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "declaration": { "$ref": "#/$defs/boundedText" },
        "verdict": { "enum": ["accepted", "rejected", "error", "skipped", "unsupported"] },
        "inputDigest": { "$ref": "#/$defs/sha256" },
        "outputDigest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "errors": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/validationError" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "accepted" } }, "required": ["verdict"] },
          "then": {
            "properties": {
              "outputDigest": { "$ref": "#/$defs/sha256" },
              "errors": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "rejected" } }, "required": ["verdict"] },
          "then": {
            "properties": {
              "outputDigest": { "type": "null" },
              "errors": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "verdict": { "enum": ["error", "skipped", "unsupported"] } },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "outputDigest": { "type": "null" },
              "errors": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
