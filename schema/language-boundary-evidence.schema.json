{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/language-boundary-evidence/v1",
  "title": "Generated language/runtime boundary evidence",
  "type": "object",
  "required": [
    "schema",
    "language",
    "runtime",
    "status",
    "sourceRevision",
    "artifactDigest",
    "receiptRunId",
    "contractIrId",
    "toolchain",
    "generator",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "ores.typespec-json-schema-validator.language-boundary-evidence/v1"
    },
    "language": {
      "$ref": "#/$defs/token"
    },
    "runtime": {
      "$ref": "#/$defs/token"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "stopped_for_evaluation"
      ]
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "receiptRunId": {
      "$ref": "#/$defs/sha256"
    },
    "contractIrId": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain": {
      "$ref": "#/$defs/tool"
    },
    "generator": {
      "$ref": "#/$defs/tool"
    },
    "validation": {
      "type": "object",
      "required": [
        "ingress",
        "egress"
      ],
      "properties": {
        "ingress": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "egress": {
          "enum": [
            "passed",
            "failed"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "$ref": "#/$defs/attolangExecution"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]).*(?<!\\s)$"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "version": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "attolangExecution": {
      "type": "object",
      "required": [
        "sourceExtension",
        "backend",
        "compilerRevision",
        "runnerRevision",
        "exactHead",
        "guestExecuted",
        "executedSteps",
        "negativeCasesPassed",
        "programRevision",
        "traceDigest",
        "negativeCasesExecuted"
      ],
      "properties": {
        "sourceExtension": {
          "const": ".atto"
        },
        "backend": {
          "enum": [
            "java",
            "llvm",
            "wasm",
            "forge",
            "dotnet"
          ]
        },
        "compilerRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runnerRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "exactHead": {
          "const": true
        },
        "guestExecuted": {
          "const": true
        },
        "executedSteps": {
          "type": "integer",
          "minimum": 1
        },
        "negativeCasesPassed": {
          "const": true
        },
        "programRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "traceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "negativeCasesExecuted": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "language": {
            "const": "attolang"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "$ref": "#/$defs/attolangExecution"
          }
        },
        "required": [
          "execution"
        ]
      },
      "else": {
        "properties": {
          "execution": false
        }
      }
    }
  ]
}
