{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/wit-projection.v1.schema.json",
  "title": "ORESoftware normalized WIT projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "worlds",
    "interfaces"
  ],
  "properties": {
    "schema": {
      "const": "ores.typespec-json-schema-validator.wit-projection/v1"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*(?::[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*)+(?:/[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*)*(?:@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)?$",
      "$comment": "WIT package declaration name with optional full Semantic Versioning 2.0 version; runtime comparison applies Component Model canonical-version identity."
    },
    "worlds": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/world"
      }
    },
    "interfaces": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/interface"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*$",
      "maxLength": 256,
      "$comment": "Normalized semantic WIT identifier; runtime normalization additionally enforces case-insensitive uniqueness within each scope."
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params",
        "results"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "params": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "results": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    "namedType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "shape"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "alias",
            "record",
            "variant",
            "enum",
            "flags",
            "resource",
            "handle",
            "tuple",
            "option",
            "result",
            "list",
            "future",
            "stream"
          ]
        },
        "shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "types",
        "functions"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "types": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/namedType"
          }
        },
        "functions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/function"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "target"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "interface",
            "function"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "imports",
        "exports"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "imports": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "exports": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "null"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
