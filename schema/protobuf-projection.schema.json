{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/typespec-json-schema-validator/protobuf-projection/v1",
  "title": "TJSV normalized Protobuf projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "syntax", "package", "messages", "enums", "services"],
  "properties": {
    "schema": {"const": "ores.typespec-json-schema-validator.protobuf-projection/v1"},
    "syntax": {"const": "proto3"},
    "package": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
    "enums": {"type": "array", "items": {"$ref": "#/$defs/enum"}},
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "typeName": {
      "type": "string",
      "pattern": "^\\.?[A-Za-z_][A-Za-z0-9_.]*(?:<[^\\s<>]+(?:,[^\\s<>]+)*>)?$"
    },
    "fieldNumber": {
      "type": "integer",
      "anyOf": [
        {"minimum": 1, "maximum": 18999},
        {"minimum": 20000, "maximum": 536870911}
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "number", "type", "cardinality", "presence", "oneof", "jsonName"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "number": {"$ref": "#/$defs/fieldNumber"},
        "type": {"$ref": "#/$defs/typeName"},
        "cardinality": {"enum": ["singular", "optional", "repeated"]},
        "presence": {"enum": ["implicit", "explicit"]},
        "oneof": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "jsonName": {
          "oneOf": [
            {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            {"type": "null"}
          ]
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields", "reservedNumbers", "reservedNames"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "reservedNumbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldNumber"}
        },
        "reservedNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "number"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "number": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      }
    },
    "enum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values", "reservedNumbers", "reservedNames"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enumValue"}},
        "reservedNumbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
        },
        "reservedNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "inputType", "outputType", "clientStreaming", "serverStreaming", "errorModel"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "inputType": {"$ref": "#/$defs/typeName"},
        "outputType": {"$ref": "#/$defs/typeName"},
        "clientStreaming": {"type": "boolean"},
        "serverStreaming": {"type": "boolean"},
        "errorModel": {"oneOf": [{"$ref": "#/$defs/typeName"}, {"type": "null"}]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "methods"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}}
      }
    }
  }
}
