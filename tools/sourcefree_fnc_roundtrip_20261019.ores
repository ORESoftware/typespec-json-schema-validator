fnc identity(int x) -> int do return x; end

fnc classify(int x) -> int do if x > 0 then return 1; else return 0; fi end

fnc callback() -> () => void do
    return || -> { return; };
end

fnc text() -> string /* ; do end */ do return "do end fi;"; end

define module math as
    fnc double(int x) -> int do return x + x; end
end
