{
  "name": "@oresoftware/typespec-json-schema-validator",
  "version": "0.1.0",
  "description": "Fail-closed parity linter for independently authored TypeSpec and JSON Schema authorities.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "types": "./src/index.d.ts"
    },
    "./runtime-conformance": {
      "import": "./src/runtime-conformance/index.mjs",
      "types": "./src/runtime-conformance/index.d.mts"
    },
    "./projection-admission": {
      "import": "./src/projection-admission/index.mjs",
      "types": "./src/projection-admission/index.d.mts"
    },
    "./projection-verification": {
      "import": "./src/projection-verification/index.mjs",
      "types": "./src/projection-verification/index.d.mts"
    },
    "./protobuf-compatibility": {
      "import": "./src/protobuf-compatibility.mjs",
      "types": "./src/protobuf-compatibility.d.mts"
    },
    "./language-boundary-verification": {
      "import": "./src/language-boundary-verification.mjs",
      "types": "./src/language-boundary-verification.d.mts"
    },
    "./language-boundary-current-inputs": {
      "import": "./src/language-boundary-current-inputs.mjs",
      "types": "./src/language-boundary-current-inputs.d.mts"
    },
    "./schema/consumer-verification-receipt": "./schema/consumer-verification-receipt.schema.json",
    "./schema/contract-ir": "./schema/contract-ir.schema.json",
    "./schema/language-boundaries": "./schema/language-boundaries.schema.json",
    "./schema/language-boundary-evidence": "./schema/language-boundary-evidence.schema.json",
    "./schema/language-boundary-verification": "./schema/language-boundary-verification.schema.json",
    "./schema/mapping": "./schema/mapping.schema.json",
    "./schema/projection-manifest": "./schema/projection-manifest.schema.json",
    "./schema/projection-verification-policy": "./schema/projection-verification-policy.schema.json",
    "./schema/projection-verification-receipt": "./schema/projection-verification-receipt.schema.json",
    "./schema/protobuf-projection": "./schema/protobuf-projection.schema.json",
    "./schema/protobuf-compatibility-receipt": "./schema/protobuf-compatibility-receipt.schema.json",
    "./schema/report": "./schema/report.schema.json",
    "./schema/runtime-conformance-report": "./schema/runtime-conformance-report.schema.json",
    "./schema/runtime-evidence": "./schema/runtime-evidence.schema.json",
    "./schema/runtime-evidence-v2": "./schema/runtime-evidence-v2.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "bin": {
    "tjsv": "./bin/typespec-json-schema-validator.mjs",
    "tsjsv": "./bin/typespec-json-schema-validator.mjs",
    "typespec-json-schema-validator": "./bin/typespec-json-schema-validator.mjs"
  },
  "files": [
    ".cli-flags.toml",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "bin",
    "docs",
    "schema",
    "src"
  ],
  "scripts": {
    "audit:prod": "node ./scripts/npm-audit-gate.mjs",
    "check": "node ./scripts/check.mjs",
    "flags:audit": "f2e audit ./.cli-flags.toml",
    "release:preflight": "node ./scripts/release-preflight-runner.mjs && node ./scripts/release-language-boundary-preflight.mjs",
    "test": "node --test ./test/unit/*.test.mjs",
    "test:integration": "node --test ./test/integration/*.test.mjs",
    "test:all": "npm run check && npm run flags:audit && npm test && npm run test:integration"
  },
  "dependencies": {
    "@oresoftware/f2e": "https://github.com/flags-2-env/flags-2-env/archive/2310d349cb87dfe7eac88ac67677e029c3e13167.tar.gz",
    "@typespec/compiler": "1.15.0",
    "@typespec/json-schema": "1.15.0"
  },
  "engines": {
    "node": ">=22.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORESoftware/typespec-json-schema-validator.git"
  },
  "keywords": [
    "typespec",
    "json-schema",
    "static-analysis",
    "schema-parity",
    "linter"
  ]
}
